# ─────────────────────────────────────────────────────────────────────────────
# Serna Directory — environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# `.env.local` and `keys.txt` are gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Which surface this deployment serves: "web" (public + owner dashboard) or
# "admin" (staff console). middleware.ts uses this to 404 the other surface.
APP_TARGET=web

# Canonical URLs (used for absolute links, emails, Stripe redirects).
NEXT_PUBLIC_SITE_URL=https://directory.sernaeducationalservices.com
NEXT_PUBLIC_ADMIN_URL=https://admin.sernaeducationalservices.com

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and public anon key — safe to expose to the browser (RLS enforced).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only. Used in exactly three places: the Stripe
# webhook, account provisioning during listing submission, and admin actions
# that have already verified the caller is an admin. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ──────────────────────────────────────────────────────────────────
# Publishable key — safe for the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Secret key — server-only.
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret from `stripe listen` / the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ID for the Featured annual plan ($400/yr).
STRIPE_FEATURED_PRICE_ID=price_xxx

# ── SendGrid (transactional email) ──────────────────────────────────────────
SENDGRID_API_KEY=SG.xxx
# Verified sender the app emails from.
SENDGRID_FROM_EMAIL=Info@SernaEducationalServices.com
SENDGRID_FROM_NAME=Serna Educational Services

# ── Google Maps / Places / Geocoding ────────────────────────────────────────
# Browser key — restrict by HTTP referrer in the Google console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-maps-key
# Server key for server-side Geocoding — restrict by IP / API.
GOOGLE_GEOCODING_API_KEY=your-server-geocoding-key

# ── reCAPTCHA v3 (spam protection on public forms) ──────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ── Cron / internal jobs ────────────────────────────────────────────────────
# Shared secret guarding cron route handlers (e.g. the asset-deletion worker).
CRON_SECRET=generate-a-long-random-string
